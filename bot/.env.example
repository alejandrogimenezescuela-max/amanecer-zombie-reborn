# Copiar este archivo como .env y completar (el .env no se sube a git).
# Los datos de MySQL se leen de ../mysql.ini, los mismos que usa el servidor.

# Discord Developer Portal > tu aplicacion > Bot > Reset Token
DISCORD_TOKEN=

# Discord Developer Portal > tu aplicacion > General Information > Application ID
DISCORD_CLIENT_ID=

# ID de tu servidor de Discord (clic derecho en el servidor > Copiar ID del servidor)
DISCORD_GUILD_ID=

# ID del rol que se da al vincular (Ajustes del servidor > Roles > clic derecho > Copiar ID del rol)
DISCORD_ROL_VINCULADO=
